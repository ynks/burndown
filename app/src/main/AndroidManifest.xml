<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".BurndownApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Burndown">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.BurndownWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_burndown_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/burndown_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.BurnupWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_burnup_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/burnup_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.BurndownChartWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_burndown_chart_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/burndown_chart_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.BurnupChartWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_burnup_chart_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/burnup_chart_widget_info" />
        </receiver>
    </application>
</manifest>
